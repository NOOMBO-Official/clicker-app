    "title": "Clicker App",
    "description": "A simple incremental clicker web app using HTML, CSS, and JavaScript with a counter, upgrades, and persistent storage.",
    "environment": "web",
    "deviceFrame": "responsive",
    "activeFilePath": "index.html",
    "createdAt": "2026-10-30T19:23:39.853Z",
    "updatedAt": "2026-10-30T19:23:39.853Z"
